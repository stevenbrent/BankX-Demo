# Copy to server/.env and fill in. Never commit the real .env.
ALLOY_BASE_URL=https://sandbox.alloy.co/v1
ALLOY_WORKFLOW_TOKEN=
ALLOY_WORKFLOW_SECRET=

# true  = return fake outcomes without calling Alloy (useful before credentials are set up)
# fail  = skip Alloy and simulate a malformed response, to demo the error-handling path
# false = call Alloy for real (requires credentials above)
ALLOY_MOCK=true

PORT=3001
